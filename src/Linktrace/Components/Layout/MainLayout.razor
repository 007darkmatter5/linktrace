@inherits LayoutComponentBase
@inject UserPreferenceService Preferences
@using Linktrace.Data

@* The saved preference decides light/dark; "Match system" follows the OS (watched below). *@
<MudThemeProvider @ref="_themeProvider" Theme="_theme" IsDarkMode="_dark" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider MaxWidth="MaxWidth.Small" FullWidth="true" CloseButton="true" BackdropClick="false" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudStaticNavDrawerToggle DrawerId="nav-drawer" @bind-Open="_drawerOpen" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" />
        <MudIcon Icon="@Icons.Material.Filled.Cable" Class="ml-3 mr-2" />
        <MudText Typo="Typo.h5">Linktrace</MudText>
        <MudSpacer />
        @if (RendererInfo.IsInteractive)
        {
            <AuthorizeView>
                @if (!context.User.IsInRole(AppRoles.Admin) && !context.User.IsInRole(AppRoles.Editor))
                {
                    <MudTooltip Text="Your account can view but not change anything. An admin can give you the Editor role on the Users page.">
                        <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Visibility" Class="mr-2">Read-only</MudChip>
                    </MudTooltip>
                }
                <GlobalSearch />
            </AuthorizeView>
            <MudMenu Icon="@ThemeIcon(_preference)" Color="Color.Inherit" title="Theme" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                @foreach (var option in Enum.GetValues<ThemePreference>())
                {
                    <MudMenuItem Icon="@ThemeIcon(option)" OnClick="() => SetTheme(option)">
                        <span style="@(option == _preference ? "font-weight: 600" : "")">@ThemeLabel(option)</span>
                        @if (option == _preference) { <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="ml-2" Style="vertical-align: middle" /> }
                    </MudMenuItem>
                }
            </MudMenu>
        }
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16 pa-4">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _dark;
    private bool _systemDark;
    private ThemePreference _preference = ThemePreference.System;
    private MudThemeProvider _themeProvider = default!;

    protected override async Task OnInitializedAsync()
    {
        // Runs during the first (server) render too, so a saved Light/Dark choice shows without a flash.
        _preference = await Preferences.GetThemeAsync();
        Apply();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive) return;
        _systemDark = await _themeProvider.GetSystemDarkModeAsync();
        await _themeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);
        if (Apply()) StateHasChanged();
    }

    private Task OnSystemDarkModeChanged(bool dark)
    {
        _systemDark = dark;
        if (Apply()) StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Works out light/dark from the preference. Returns true if it changed.</summary>
    private bool Apply()
    {
        var dark = _preference switch
        {
            ThemePreference.Dark => true,
            ThemePreference.Light => false,
            _ => _systemDark
        };
        var changed = dark != _dark;
        _dark = dark;
        return changed;
    }

    private async Task SetTheme(ThemePreference preference)
    {
        _preference = preference;
        Apply();
        await Preferences.SetThemeAsync(preference);
    }

    private static string ThemeIcon(ThemePreference p) => p switch
    {
        ThemePreference.Light => Icons.Material.Filled.LightMode,
        ThemePreference.Dark => Icons.Material.Filled.DarkMode,
        _ => Icons.Material.Filled.BrightnessAuto
    };

    private static string ThemeLabel(ThemePreference p) => p switch
    {
        ThemePreference.Light => "Light",
        ThemePreference.Dark => "Dark",
        _ => "Match system"
    };

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#1565c0", Secondary = "#ef6c00", AppbarBackground = "#0d47a1" },
        PaletteDark = new PaletteDark { Primary = "#64b5f6", Secondary = "#ffb74d" }
    };
}
