@inherits DialogBase
@inject CableService Cables

<MudDialog>
    <DialogContent>
        <CableFields Cable="Model" />
        @if (Error is not null) { <MudAlert Severity="Severity.Error" Class="mt-4">@Error</MudAlert> }
    </DialogContent>
    <DialogActions>
        <DialogFooter OnCancel="Cancel" OnSave="Save" Busy="Busy" />
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Cable Model { get; set; } = new();

    private Task Save() => SubmitAsync(() => Cables.UpdateAsync(Model));
}
